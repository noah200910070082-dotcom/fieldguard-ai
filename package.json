    "@tanstack/react-query": "^5.62.0",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "framer-motion": "^11.12.0",
    "i18next": "^24.2.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.2.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.1.0",
    "recharts": "^2.15.0",
    "three": "^0.170.0",
    "zustand": "^5.0.0"
